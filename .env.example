# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=replace_me_with_a_long_random_string
# Fernet key for encrypting OAuth tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
MCP_SHARED_SECRET=replace_me_with_another_long_random_string

DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# ---- Marketplace
MARKETPLACE_MODE=gigsim                 # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_SECRET=replace_me                # shared by GigSim and the marketplace MCP server
GIGSIM_ADMIN_TOKEN=replace_me
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# ---- Models (open profile is required; any OpenAI-compatible open-model host works)
MODEL_PROFILE=open
OPEN_LLM_BASE_URL=https://api.cerebras.ai/v1
OPEN_LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
PAID_LLM_BASE_URL=
PAID_LLM_API_KEY=

# ---- MCP servers
PORTFOLIO_MCP_URL=http://localhost:8091/mcp
MARKETPLACE_MCP_URL=http://localhost:8092/mcp
WORKSPACE_MCP_URL=http://localhost:8093/mcp
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=                       # fine-grained PAT, read-only public repos

# ---- Tracing (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# ---- Web
WEB_ORIGIN=http://localhost:5173
REVIEWER_EMAIL=reviewer@gigbid.test
REVIEWER_PASSWORD=                      # set at deploy time; shared only in the private GCR comment
