    "output": {
      "properties": {
        "client_industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Client Industry"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "related_items": {
          "items": {
            "type": "string"
          },
          "title": "Related Items",
          "type": "array"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        }
      },
      "required": [
        "project_id",
        "title",
        "text",
        "skills",
        "date",
        "client_industry",
        "related_items"
      ],
      "title": "CaseStudy",
      "type": "object"
    }
  },
