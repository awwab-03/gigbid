    "input": {
      "properties": {
        "project_id": {
          "description": "e.g. ml-03",
          "maxLength": 32,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "get_case_studyArguments",
      "type": "object"
