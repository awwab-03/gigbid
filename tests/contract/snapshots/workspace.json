{
  "create_email_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "input": {
      "properties": {
        "body": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "maxLength": 200,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to",
        "subject",
        "body",
        "idempotency_key"
      ],
      "title": "create_email_draftArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "draft_id": {
          "title": "Draft Id",
          "type": "string"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "status": {
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "to",
        "subject",
        "body"
      ],
      "title": "EmailDraft",
      "type": "object"
    }
  },
  "create_interview_hold": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "input": {
      "properties": {
        "duration_min": {
          "maximum": 180,
          "minimum": 15,
          "title": "Duration Min",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "start": {
          "description": "ISO 8601 start",
          "title": "Start",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "duration_min",
        "title",
        "idempotency_key"
      ],
      "title": "create_interview_holdArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "end": {
          "title": "End",
          "type": "string"
        },
        "hold_id": {
          "title": "Hold Id",
          "type": "string"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "status": {
          "default": "tentative",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "hold_id",
        "start",
        "end",
        "title"
      ],
      "title": "Hold",
      "type": "object"
    }
  },
  "free_slots": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "input": {
      "properties": {
        "days": {
          "default": 5,
          "maximum": 14,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "duration_min": {
          "default": 30,
          "maximum": 180,
          "minimum": 15,
          "title": "Duration Min",
          "type": "integer"
        },
        "max_slots": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Slots",
          "type": "integer"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD; default tomorrow",
          "title": "Start Date"
        },
        "timezone_name": {
          "default": "Asia/Karachi",
          "maxLength": 64,
          "title": "Timezone Name",
          "type": "string"
        }
      },
      "title": "free_slotsArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Slot": {
          "properties": {
            "end": {
              "title": "End",
              "type": "string"
            },
            "label": {
              "description": "Human-friendly, e.g. 'Tue 12 Nov, 3:00 PM PKT'",
              "title": "Label",
              "type": "string"
            },
            "start": {
              "description": "ISO 8601 with offset",
              "title": "Start",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end",
            "label"
          ],
          "title": "Slot",
          "type": "object"
        }
      },
      "properties": {
        "slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "slots"
      ],
      "title": "SlotList",
      "type": "object"
    }
  }
}