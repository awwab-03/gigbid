{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "input": {
      "properties": {
        "bid_amount": {
          "description": "USD total (fixed) or USD/hour (hourly)",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Bid Amount",
          "type": "number"
        },
        "bid_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Bid Type",
          "type": "string"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 50,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Unique key for this logical write; reuse it when retrying.",
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9:_\\-.]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "bid_type",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "output": {
      "description": "Result of a write tool. With dry_run=True nothing is written and `preview` shows exactly\nwhat would be sent and what it costs.",
      "properties": {
        "balance_after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance After"
        },
        "connects_cost": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connects Cost"
        },
        "connects_spent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connects Spent"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotent_replay": {
          "default": false,
          "title": "Idempotent Replay",
          "type": "boolean"
        },
        "marketplace": {
          "default": "gigsim",
          "title": "Marketplace",
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "preview": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Id"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "ok",
        "dry_run"
      ],
      "title": "WriteResult",
      "type": "object"
    }
  },
